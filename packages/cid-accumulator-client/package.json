{
	"name": "cid-accumulator-client",
	"type": "module",
	"version": "0.3.0",
	"description": "JS/TS client for interacting with CIDAccumulatorSingleton",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"clean": "rm -rf dist",
		"prepare": "npm run build",
		"lint": "eslint \"source/**/*.{ts,js}\"",
		"seeder": "tsx ./source/core/seeder/runSeeder.ts"
	},
	"devDependencies": {
		"@types/node": "^18.19.87",
		"dotenv": "^16.0.3",
		"ethers": "^6.6.2",
		"prettier": "^2.8.4",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"source",
		"README.md"
	],
	"license": "MIT",
	"dependencies": {
		"@noble/hashes": "1.8.0"
	}
}
