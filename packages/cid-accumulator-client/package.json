{
	"name": "cid-accumulator-client",
	"type": "module",
	"version": "0.4.0",
	"engines": {
		"node": ">=26.13.1"
	},
	"description": "JS/TS client for interacting with contracts that inherit CIDAccumulator",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"pretest": "npm run build",
		"test": "node --import tsx --test test/*.test.ts",
		"clean": "rm -rf dist",
		"prepare": "npm run build",
		"lint": "eslint \"source/**/*.{ts,js}\"",
		"seeder": "tsx ./scripts/runSeeder.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"dotenv": "^16.0.3",
		"eslint": "^10.15.0",
		"ethers": "^6.6.2",
		"prettier": "^2.8.4",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.73.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"source",
		"README.md"
	],
	"license": "MIT",
	"dependencies": {
		"@noble/hashes": "1.8.0"
	}
}
